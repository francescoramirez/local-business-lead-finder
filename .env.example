# Copy this file to .env and replace the placeholder.
# Never commit a real key. Restrict the key to Places API (New) in Google Cloud.

GOOGLE_MAPS_API_KEY=your-places-api-key-here

# Optional alias. leadfinder accepts either name.
# GOOGLE_PLACES_API_KEY=your-places-api-key-here

# Optional. Enables AI Sales Prep and aggregated insight explanations (never a CLI flag).
# GROQ_API_KEY=your-groq-api-key-here
# GROQ_MODEL=llama-3.3-70b-versatile
